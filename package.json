{
	"name": "wraith",
	"version": "0.1.0",
	"description": "TUI estilo Task Manager para gestionar procesos y servicios de Windows. React + Ink sobre Bun (Yoga para el layout).",
	"type": "module",
	"private": true,
	"bin": {
		"wraith": "./src/cli.tsx"
	},
	"scripts": {
		"dev": "bun run src/cli.tsx",
		"mock": "bun run src/cli.tsx --mock",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.2.17"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"ink": "^7.0.6",
		"react": "^19.2.7"
	}
}
